[
  {
    "name": "basic cycle",
    "req": ["REQ-001", "REQ-002", "REQ-003"],
    "steps": [{ "t": 0 }],
    "expect": [
      { "t": 0, "phase": "work", "canPause": true },
      { "t": 1189, "phase": "work" },
      { "t": 1190, "phase": "warning", "canPause": false },
      { "t": 1199, "phase": "warning" },
      { "t": 1200, "phase": "break", "canPause": false },
      { "t": 1229, "phase": "break" },
      { "t": 1230, "phase": "work", "canPause": true },
      { "t": 2419, "phase": "work" },
      { "t": 2420, "phase": "warning" },
      { "t": 2430, "phase": "break" }
    ]
  },
  {
    "name": "idle resets",
    "req": ["REQ-005"],
    "steps": [{ "t": 0 }, { "t": 600, "idle": 300 }, { "t": 601, "idle": 0 }],
    "expect": [
      { "t": 599, "phase": "work" },
      { "t": 1200, "phase": "work" },
      { "t": 1790, "phase": "work" },
      { "t": 1791, "phase": "warning" }
    ]
  },
  {
    "name": "restart is fresh",
    "req": ["REQ-007"],
    "start": 5000,
    "steps": [{ "t": 5000 }],
    "expect": [
      { "t": 6189, "phase": "work" },
      { "t": 6190, "phase": "warning" }
    ]
  },
  {
    "name": "pause 1h",
    "req": ["REQ-008"],
    "steps": [{ "t": 0 }, { "t": 10, "do": "pause:3600" }],
    "expect": [
      { "t": 10, "phase": "paused", "pauseResult": true },
      { "t": 11, "phase": "paused", "canPause": false },
      { "t": 3609, "phase": "paused" },
      { "t": 3610, "phase": "work" },
      { "t": 4799, "phase": "work" },
      { "t": 4800, "phase": "warning" }
    ]
  },
  {
    "name": "pause too long",
    "req": ["REQ-008"],
    "steps": [{ "t": 0 }, { "t": 10, "do": "pause:10801" }],
    "expect": [
      { "t": 10, "phase": "work", "pauseResult": false },
      { "t": 11, "phase": "work" }
    ]
  },
  {
    "name": "pause max",
    "req": ["REQ-008"],
    "steps": [{ "t": 0 }, { "t": 10, "do": "pause:10800" }],
    "expect": [
      { "t": 10, "phase": "paused", "pauseResult": true },
      { "t": 11, "phase": "paused" }
    ]
  },
  {
    "name": "no pause in warning",
    "req": ["REQ-008"],
    "steps": [{ "t": 0 }, { "t": 1195, "do": "pause:600" }],
    "expect": [
      { "t": 1195, "phase": "warning", "pauseResult": false },
      { "t": 1200, "phase": "break" }
    ]
  },
  {
    "name": "no pause in break",
    "req": ["REQ-008"],
    "steps": [{ "t": 0 }, { "t": 1210, "do": "pause:600" }],
    "expect": [
      { "t": 1210, "phase": "break", "pauseResult": false }
    ]
  },
  {
    "name": "one per day",
    "req": ["REQ-009"],
    "steps": [{ "t": 0 }, { "t": 10, "do": "pause:60" }, { "t": 80, "do": "pause:60" }, { "t": 86400, "do": "pause:60" }],
    "expect": [
      { "t": 10, "phase": "paused", "pauseResult": true },
      { "t": 80, "phase": "work", "pauseResult": false, "canPause": false },
      { "t": 86400, "phase": "paused", "pauseResult": true }
    ]
  },
  {
    "name": "cancel uses the day",
    "req": ["REQ-009", "REQ-010"],
    "steps": [{ "t": 0 }, { "t": 10, "do": "pause:3600" }, { "t": 20, "do": "cancelPause" }, { "t": 30, "do": "pause:60" }],
    "expect": [
      { "t": 30, "phase": "work", "pauseResult": false }
    ]
  },
  {
    "name": "restart keeps the day",
    "req": ["REQ-009"],
    "lastPauseDay": "0",
    "steps": [{ "t": 0 }, { "t": 10, "do": "pause:60" }],
    "expect": [
      { "t": 10, "phase": "work", "pauseResult": false, "canPause": false }
    ]
  },
  {
    "name": "cancel",
    "req": ["REQ-010"],
    "steps": [{ "t": 0 }, { "t": 10, "do": "pause:3600" }, { "t": 100, "do": "cancelPause" }],
    "expect": [
      { "t": 100, "phase": "work" },
      { "t": 101, "phase": "work", "canPause": false },
      { "t": 1289, "phase": "work" },
      { "t": 1290, "phase": "warning" }
    ]
  },
  {
    "name": "idle ignored while paused",
    "req": ["REQ-008"],
    "steps": [{ "t": 0 }, { "t": 10, "do": "pause:3600" }, { "t": 20, "idle": 900 }],
    "expect": [
      { "t": 20, "phase": "paused" },
      { "t": 3609, "phase": "paused" },
      { "t": 3610, "phase": "work" }
    ]
  },
  {
    "name": "call holds",
    "req": ["REQ-011"],
    "steps": [{ "t": 0 }, { "t": 1000, "inCall": true }, { "t": 5000, "inCall": false }],
    "expect": [
      { "t": 1189, "phase": "work" },
      { "t": 1190, "phase": "work", "canPause": true },
      { "t": 5000, "phase": "warning" },
      { "t": 5009, "phase": "warning" },
      { "t": 5010, "phase": "break" }
    ]
  },
  {
    "name": "call cap",
    "req": ["REQ-012"],
    "steps": [{ "t": 0 }, { "t": 1000, "inCall": true }],
    "expect": [
      { "t": 11989, "phase": "work" },
      { "t": 11990, "phase": "warning" },
      { "t": 11999, "phase": "warning" },
      { "t": 12000, "phase": "break" },
      { "t": 12029, "phase": "break" },
      { "t": 12030, "phase": "work" }
    ]
  },
  {
    "name": "call during warning ignored",
    "req": ["REQ-011"],
    "steps": [{ "t": 0 }, { "t": 1195, "inCall": true }],
    "expect": [
      { "t": 1195, "phase": "warning" },
      { "t": 1200, "phase": "break" }
    ]
  },
  {
    "name": "call during break ignored",
    "req": ["REQ-011"],
    "steps": [{ "t": 0 }, { "t": 1210, "inCall": true }],
    "expect": [
      { "t": 1229, "phase": "break" },
      { "t": 1230, "phase": "work" }
    ]
  },
  {
    "name": "phone call uncapped",
    "req": ["REQ-013"],
    "steps": [{ "t": 0 }, { "t": 1000, "inPhoneCall": true }, { "t": 21190, "inPhoneCall": false }],
    "expect": [
      { "t": 21189, "phase": "work" },
      { "t": 21190, "phase": "warning" },
      { "t": 21199, "phase": "warning" },
      { "t": 21200, "phase": "break" }
    ]
  },
  {
    "name": "phone call then call still on",
    "req": ["REQ-013"],
    "steps": [{ "t": 0 }, { "t": 1000, "inPhoneCall": true, "inCall": true }, { "t": 15000, "inPhoneCall": false, "inCall": true }],
    "expect": [
      { "t": 14999, "phase": "work" },
      { "t": 15000, "phase": "warning" },
      { "t": 15009, "phase": "warning" },
      { "t": 15010, "phase": "break" }
    ]
  }
]
